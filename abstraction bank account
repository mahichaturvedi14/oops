class bank{
	private:
		int balance;
		
	
		public:
			void deposit(int amt){
				balance= balance+amt;
				
				cout<<" money deposited"<< endl;
				
			}
			void withdraw(int amt){
				balance= balance-amt;
				cout<<"money withdrawn"<<endl;
			}
			void showbalance(){
				cout<<"balance is "<< balance <<endl;
			}
};
       
